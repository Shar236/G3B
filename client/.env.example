# ---------------------------------------------------------------------------
# G3B Education - Frontend Environment Configuration (Vite)
# ---------------------------------------------------------------------------
# NOTE: Variables prefixed with VITE_ are embedded into public client bundles.
# NEVER place database credentials, JWT secrets, or private API keys here.
# ---------------------------------------------------------------------------

# Public backend API URL:
# - Local development: Leave EMPTY. Vite's proxy forwards /api and /uploads
#   directly to http://localhost:5000 without CORS issues.
# - Monorepo production (Express serves client/dist): Leave EMPTY. The frontend
#   makes same-origin calls to /api on the same host.
# - Separate frontend hosting (e.g., Vercel, Netlify): Set to your public backend
#   origin, e.g. https://your-backend-service.up.railway.app (do NOT append /api).
VITE_API_URL=

# Private admin base path. Must match the server's ADMIN_ROUTE.
# Defaults to /manage-portal when unset.
# (Authorisation is enforced server-side; this path keeps admin routes out of public navigation)
VITE_ADMIN_ROUTE=/manage-portal
