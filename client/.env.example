# Base URL of the Express API.
# Leave empty during development so Vite's proxy forwards /api and /uploads to
# http://localhost:5000. In production set the public API origin, for example:
# VITE_API_URL=https://api.g3beducation.com
VITE_API_URL=

# Private admin base path. Must match the server's ADMIN_ROUTE.
# Defaults to /manage-portal when unset.
# This is NOT a security control - the admin area is protected by server-side
# authentication and authorisation, not by the obscurity of the URL.
# VITE_ADMIN_ROUTE=/manage-portal
