{
  "name": "g3b-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "G3B Education backend API (Express + Supabase PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:supabase": "node scripts/migrate-mysql-to-supabase.js",
    "verify:supabase": "node scripts/verify-supabase-migration.js",
    "db:setup": "npm run migrate:supabase",
    "create-admin": "node src/db/createAdmin.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "mysql2": "^3.11.4",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "vitest": "^2.1.5"
  }
}
