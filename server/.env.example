# ---------------------------------------------------------------
# G3B Education backend configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Comma separated list of allowed browser origins for CORS
CLIENT_ORIGINS=http://localhost:5173

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=g3b_education
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Maximum number of connections held open in the MySQL pool
DB_CONNECTION_LIMIT=10

# Authentication
# Generate a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=12h

# Cookie / CSRF
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# First administrator (used by `npm run seed` / `npm run create-admin`)
ADMIN_NAME=G3B Administrator
ADMIN_EMAIL=admin@g3beducation.com
ADMIN_PASSWORD=ChangeMe123!

# Email (SMTP). Leave MAIL_HOST empty to disable email delivery.
# Enquiries are still persisted; failed notifications are queued for retry.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="G3B Education <no-reply@g3beducation.com>"
ADMIN_NOTIFICATION_EMAIL=admissions.g3beducation@gmail.com

# Uploads / media storage
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Rate limiting
ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=15
ENQUIRY_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
