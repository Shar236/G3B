# ---------------------------------------------------------------------------
# G3B Education - Backend Environment Configuration (Express + Supabase PostgreSQL)
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=5000

# Comma-separated list of allowed browser origins for CORS.
# In local development: http://localhost:5173,http://localhost:5174
# In production: Include your public frontend URL (e.g. https://your-frontend.vercel.app)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Canonical public site URL (used in SEO meta, Open Graph, and sitemap generation)
PUBLIC_SITE_URL=

# Serve the built client (client/dist) and prerendered SEO from Express.
# Enabled automatically when NODE_ENV=production. Set true locally to test.
SERVE_CLIENT=false

# ---------------------------------------------------------------------------
# Runtime database (Supabase PostgreSQL; backend/Railway only)
# ---------------------------------------------------------------------------
# Use Supabase's transaction pooler URL on Railway. Never expose this in Vite.
DATABASE_URL=postgresql://postgres.project-ref:your_password@pooler-host:6543/postgres?sslmode=require
# Alias supported when DATABASE_URL is managed by another Railway plugin:
SUPABASE_DB_URL=

# Keep this conservative when using a hosted pooler.
DB_CONNECTION_LIMIT=10
DB_SSL=true

# Source MySQL settings are used only by `npm run migrate:supabase` and
# `npm run verify:supabase`; they are not used by the running application.
SOURCE_DB_HOST=your_existing_mysql_host
SOURCE_DB_PORT=3306
SOURCE_DB_NAME=g3b_education
SOURCE_DB_USER=your_existing_mysql_user
SOURCE_DB_PASSWORD=your_existing_mysql_password
SOURCE_DB_SSL=true
# Required one-time safety acknowledgement. Remove after migration.
ALLOW_SUPABASE_SCHEMA_CREATE=false

# ---------------------------------------------------------------------------
# Authentication & Security
# ---------------------------------------------------------------------------
# REQUIRED in production: At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=12h

# Cookie security: set COOKIE_SECURE=true and COOKIE_SAMESITE=lax (or strict) in production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Admin route prefix (must match client's VITE_ADMIN_ROUTE)
ADMIN_ROUTE=/manage-portal

# First administrator credentials (seeded automatically on fresh database)
ADMIN_NAME=G3B Administrator
ADMIN_EMAIL=admin@g3beducation.com
ADMIN_PASSWORD=ChangeMe123!

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
# Leave MAIL_HOST empty to disable email delivery. Enquiries are still stored safely.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="G3B Education <no-reply@g3beducation.com>"
ADMIN_NOTIFICATION_EMAIL=admissions.g3beducation@gmail.com

# ---------------------------------------------------------------------------
# Uploads / Media Storage
# ---------------------------------------------------------------------------
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=15
ENQUIRY_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# YouTube Integration (Backend Only - Never expose via VITE_*)
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_SHORTS_PLAYLIST_ID=
YOUTUBE_AUTO_SYNC=true
YOUTUBE_SYNC_INTERVAL_MINUTES=360
YOUTUBE_SYNC_MAX_PAGES=500
YOUTUBE_REQUEST_TIMEOUT_MS=12000
YOUTUBE_SYNC_MAX_MS=120000
